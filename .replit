entrypoint = "main.py"
modules = ["python-3.11", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["libiconv", "libxcrypt"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "autoscale"

[userenv]

[userenv.shared]
ABLITERATION_BASE_URL = "https://api.abliteration.ai/v1"
ABLITERATION_MODEL = "abliterated-model-large-flash"
HOPPER_BASE_URL = "https://api.withhopper.com/v1"
HOPPER_MODEL = "deepseek-v4.1-flash-1017-abliterated"
INSTAVM_BASE_URL = "https://api.instavm.io"
FLYMYAI_BASE_URL = "https://api.flymy.ai"
FLYMYAI_IMAGE_MODEL = "flymyai/nano-banana-2_1"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
